[submodule "components/gcc"]
	path = components/gcc
	url = https://github.com/StochasticEagle/psp-gcc.git
	branch = allegrex-v15.2.0
	shallow = true
[submodule "components/newlib"]
	path = components/newlib
	url = https://github.com/StochasticEagle/psp-newlib.git
	branch = master
	shallow = true
[submodule "components/pthread"]
	path = components/pthread
	url = https://github.com/StochasticEagle/psp-pthread.git
	branch = platform_agnostic
	shallow = true
[submodule "components/binutils-gdb"]
	shallow = true
	path = components/binutils-gdb
	url = https://github.com/StochasticEagle/psp-binutils-gdb.git
	branch = dev/fork
